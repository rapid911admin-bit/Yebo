# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# NEON_PROJECT_ID: Your Neon Serverless PostgreSQL project identifier.
NEON_PROJECT_ID="patient-snow-11357681"

# NEON_DATABASE_URL: Neon PostgreSQL connection string.
# Example format: postgresql://neondb_owner:YOUR_PASSWORD@ep-patient-snow-11357681.us-east-2.aws.neon.tech/neondb?sslmode=require
NEON_DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-patient-snow-11357681.us-east-2.aws.neon.tech/neondb?sslmode=require"
